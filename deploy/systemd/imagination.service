[Unit]
Description=Imagination Scramjet Proxy Engine
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/imagination
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
