{
  "name": "imagination",
  "version": "1.2.0",
  "description": "Self-hosted Node.js Scramjet browser with Wisp and libcurl transport.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && node --check src/config.js && node --check public/app.js && node --check public/proxy.js && node --check public/sw.js",
    "health": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>r.json()).then(console.log)\"",
    "docker:build": "docker build -t imagination-proxy .",
    "docker:run": "docker run --rm -p 8080:8080 --env-file .env imagination-proxy"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "fastify": "^5.7.4",
    "ws": "^8.18.3"
  }
}
